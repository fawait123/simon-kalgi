generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HealthWorkerRole {
  spesialis
  umum
  perawat
  asisten
}

enum WorkerStatus {
  aktif
  cuti
  nonaktif
}

enum Gender {
  L
  P
}

enum EmploymentStatus {
  tetap
  mitra
  residen
}

enum AccessLevel {
  dokter
  perawat
  admin
}

enum BloodType {
  A
  B
  AB
  O
}

enum OhisCategory {
  baik
  sedang
  buruk
}

enum ControlPriority {
  normal
  urgent
}

enum MonitoringStatus {
  terkontrol
  perlu_perhatian
  terlambat
  kritis
}

enum ToothCondition {
  sehat
  karies
  tambalan
  mahkota
  hilang
}

enum IndexSurface {
  buccal
  labial
  lingual
  palatal
}

enum HeartRhythm {
  reguler
  tidak_reguler
}

enum ExaminationStatus {
  draft
  final
}

enum NotificationCategory {
  pengingat
  jadwal
  sistem
}

model HealthWorker {
  id               String           @id @default(uuid()) @db.Uuid
  medicalId        String           @unique @map("medical_id") @db.VarChar(15)
  fullName         String           @map("full_name") @db.VarChar(120)
  nik              String           @unique @db.Char(16)
  birthDate        DateTime         @map("birth_date") @db.Date
  gender           Gender
  employmentStatus EmploymentStatus @default(tetap) @map("employment_status")
  role             HealthWorkerRole
  specialization   String?          @db.VarChar(100)
  strNumber        String           @map("str_number") @db.VarChar(40)
  strExpiryDate    DateTime         @map("str_expiry_date") @db.Date
  phone            String           @db.VarChar(20)
  email            String           @unique @db.VarChar(120)
  address          String?          @db.VarChar(255)
  username         String           @unique @db.VarChar(40)
  passwordHash     String           @map("password_hash")
  accessLevel      AccessLevel      @map("access_level")
  dutyDays         String           @map("duty_days") @db.VarChar(80)
  dutyTime         String           @map("duty_time") @db.VarChar(60)
  status           WorkerStatus     @default(aktif)
  isPic            Boolean          @default(false) @map("is_pic")
  avatarUrl        String?          @map("avatar_url")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  examinations  Examination[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@index([strNumber])
  @@map("health_workers")
}

model Examination {
  id               String            @id @default(uuid()) @db.Uuid
  patientId        String            @map("patient_id") @db.Uuid
  examinerId       String?           @map("examiner_id") @db.Uuid
  examinerName     String            @map("examiner_name") @db.VarChar(120)
  examDate         DateTime          @map("exam_date") @db.Date
  chiefComplaint   String            @map("chief_complaint") @db.VarChar(600)
  bloodPressure    String?           @map("blood_pressure") @db.VarChar(20)
  heartRate        Int?              @map("heart_rate")
  heartRhythm      HeartRhythm       @default(reguler)
  gingivaCondition String            @map("gingiva_condition") @db.VarChar(255)
  mobilityDegree   Int               @default(0) @map("mobility_degree")
  mucosaCondition  String            @map("mucosa_condition") @db.VarChar(120)
  prescriptionNote String?           @map("prescription_note") @db.VarChar(600)
  hygieneDiagnosis String?           @map("hygiene_diagnosis") @db.VarChar(600)
  planOfAction     String[]          @map("plan_of_action")
  debrisIndex      Float             @default(0) @map("debris_index")
  calculusIndex    Float             @default(0) @map("calculus_index")
  ohisScore        Float             @default(0) @map("ohis_score")
  ohisCategory     OhisCategory      @default(baik) @map("ohis_category")
  healthyTeeth     Int               @default(0) @map("healthy_teeth")
  dmftScore        Int               @default(0) @map("dmft_score")
  status           ExaminationStatus @default(draft)
  nextVisitAt      DateTime?         @map("next_visit_at")
  nextVisitNote    String?           @map("next_visit_note") @db.VarChar(200)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  patient     Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  examiner    HealthWorker?           @relation(fields: [examinerId], references: [id], onDelete: SetNull)
  teeth       ExaminationTooth[]
  indexScores ExaminationIndexScore[]

  @@index([patientId, examDate])
  @@index([status])
  @@map("examinations")
}

model ExaminationTooth {
  id            String         @id @default(uuid()) @db.Uuid
  examinationId String         @map("examination_id") @db.Uuid
  fdiNumber     Int            @map("fdi_number")
  condition     ToothCondition @default(sehat)
  note          String?        @db.VarChar(120)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  @@unique([examinationId, fdiNumber])
  @@map("examination_teeth")
}

model ExaminationIndexScore {
  id            String       @id @default(uuid()) @db.Uuid
  examinationId String       @map("examination_id") @db.Uuid
  fdiNumber     Int          @map("fdi_number")
  surface       IndexSurface
  debrisValue   Int          @default(0) @map("debris_value")
  calculusValue Int          @default(0) @map("calculus_value")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  @@unique([examinationId, fdiNumber])
  @@map("examination_index_scores")
}

model Patient {
  id                 String          @id @default(uuid()) @db.Uuid
  medicalRecordNo    String          @unique @map("medical_record_no") @db.VarChar(15)
  nik                String          @unique @db.Char(16)
  fullName           String          @map("full_name") @db.VarChar(120)
  birthDate          DateTime        @map("birth_date") @db.Date
  gender             Gender
  bloodType          BloodType?      @map("blood_type")
  phone              String          @db.VarChar(20)
  email              String?         @unique @db.VarChar(120)
  address            String          @db.VarChar(255)
  allergyAntibiotics Boolean         @default(false) @map("allergy_antibiotics")
  hypertension       Boolean         @default(false)
  diabetes           Boolean         @default(false)
  ohisScore          Float?          @map("ohis_score")
  debrisIndex        Float?          @map("debris_index")
  calculusIndex      Float?          @map("calculus_index")
  ohisCategory       OhisCategory?   @map("ohis_category")
  healthyTeeth       Int             @default(0) @map("healthy_teeth")
  odontogramNote     String?         @map("odontogram_note") @db.VarChar(200)
  dmftScore          Int?            @map("dmft_score")
  lastVisitAt        DateTime?       @map("last_visit_at") @db.Date
  nextVisitAt        DateTime?       @map("next_visit_at")
  nextVisitClinician String?         @map("next_visit_clinician") @db.VarChar(120)
  controlTitle       String?         @map("control_title") @db.VarChar(80)
  controlNote        String?         @map("control_note") @db.VarChar(120)
  controlPriority    ControlPriority @default(normal) @map("control_priority")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  visits        PatientVisit[]
  examinations  Examination[]
  monitoring    PatientMonitoring?
  notifications Notification[]

  @@index([gender])
  @@index([ohisCategory])
  @@index([fullName])
  @@map("patients")
}

model PatientVisit {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  visitDate     DateTime @map("visit_date") @db.Date
  title         String   @db.VarChar(160)
  clinicianName String   @map("clinician_name") @db.VarChar(120)
  ohisScore     Float?   @map("ohis_score")
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, visitDate])
  @@map("patient_visits")
}

model PatientMonitoring {
  id                    String           @id @default(uuid()) @db.Uuid
  patientId             String           @unique @map("patient_id") @db.Uuid
  programName           String           @map("program_name") @db.VarChar(120)
  status                MonitoringStatus @default(terkontrol)
  checklistPercent      Int              @default(0) @map("checklist_percent")
  baselineOhisScore     Float?           @map("baseline_ohis_score")
  baselineDebrisIndex   Float?           @map("baseline_debris_index")
  baselineCalculusIndex Float?           @map("baseline_calculus_index")
  scheduledVisitAt      DateTime?        @map("scheduled_visit_at")
  scheduledVisitNote    String?          @map("scheduled_visit_note") @db.VarChar(120)
  reminderConfirmed     Boolean          @default(false) @map("reminder_confirmed")
  reminderSentAt        DateTime?        @map("reminder_sent_at")
  doctorNote            String?          @map("doctor_note") @db.VarChar(500)
  validatedByClinician  String?          @map("validated_by_clinician") @db.VarChar(120)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledVisitAt])
  @@map("patient_monitorings")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  category    NotificationCategory @default(pengingat)
  title       String               @db.VarChar(120)
  body        String               @db.VarChar(400)
  patientId   String?              @map("patient_id") @db.Uuid
  link        String?              @db.VarChar(160)
  isRead      Boolean              @default(false) @map("is_read")
  readAt      DateTime?            @map("read_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  recipient HealthWorker @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  patient   Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}
